{
  "name": "zurie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "NEXT_DIST_DIR=.next-dev next dev",
    "clean": "rm -rf .next .next-dev .next-prod",
    "clean:prod": "rm -rf .next-prod",
    "build": "next build",
    "build:local": "npm run clean:prod && NEXT_DIST_DIR=.next-prod next build",
    "start": "next start",
    "start:local": "NEXT_DIST_DIR=.next-prod next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^5.5.7",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.10",
    "@mui/material-nextjs": "^7.3.10",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "hoist-non-react-statics": "^3.3.2",
    "next": "^15.5.22",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.22",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5"
  }
}
